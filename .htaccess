# ==============================================================================
# Parlance MyBiz - Hardened Apache Configuration (.htaccess)
# Designed for HostGator cPanel (public_html)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Basic Options & Directory Security
# ------------------------------------------------------------------------------
Options -Indexes -MultiViews +FollowSymLinks

# Prevent Directory Browsing
IndexIgnore *

# Default Charset
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 2. HTTPS Enforcement & Canonical URL
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block Malicious Exploits, Web Shells & Bot Queries
  RewriteCond %{QUERY_STRING} (eval\(|base64_decode|base64_encode|GLOBALS\[|_REQUEST\[|mosConfig_) [NC,OR]
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|win\.ini) [NC,OR]
  RewriteCond %{REQUEST_URI} (\.php|\.phtml|\.php3|\.php4|\.php5|\.phps|\.cgi|\.pl)$ [NC]
  # Reject any attempt to request PHP or executable files directly on this static site
  RewriteRule ^ - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Clickjacking Protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Cross-Site Scripting (XSS) Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  
  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ------------------------------------------------------------------------------
# 4. Block Sensitive Files & Hidden Directories
# ------------------------------------------------------------------------------
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

<FilesMatch "(?i:\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|gitignore|yml|yaml|md))$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------------------
# 5. Disable PHP / Script Engine Execution
# ------------------------------------------------------------------------------
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# ------------------------------------------------------------------------------
# 6. Gzip / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 7. Browser Caching (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

